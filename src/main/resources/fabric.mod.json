{
  "schemaVersion": 1,
  "id": "cinecraft",
  "version": "${version}",
  "name": "CineCraft",
  "description": "A cinematic camera system for Minecraft.",
  "authors": ["CineCraft Team"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "main": ["com.cinecraft.CineCraft"],
    "client": ["com.cinecraft.client.CineCraftClient"]
  },
  "mixins": [
    "cinecraft.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
